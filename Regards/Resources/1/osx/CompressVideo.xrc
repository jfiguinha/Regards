<?xml version="1.0" encoding="utf-8" ?>
<resource xmlns="http://wxwidgets.org">
	<object class="wxDialog" name="CompressVideo">
		<title>Video Compression</title>
		<centered>1</centered>
		<size>400,440</size>
		<object class="wxStaticBitmap" name="ID_BITMAPVIDEO">
			<pos>24,20</pos>
			<size>344,240</size>
		</object>
		<object class="wxStaticText" name="ID_STPROGRESS">
			<label>Progression :</label>
			<pos>32,270</pos>
			<size>72,13</size>
		</object>
		<object class="wxStaticText" name="ID_STTEXT_ELAPSED_LABEL">
			<label>Time Elapsed : </label>
			<pos>32,295</pos>
		</object>	
		<object class="wxStaticText" name="ID_STTIMEELAPSED">
			<label>---</label>
			<pos>130,295</pos>
		</object>			
		<object class="wxStaticText" name="ID_STTEXT_FRAME_LABEL">
			<label>Nb Frame :</label>
			<pos>220,295</pos>
		</object>	
		<object class="wxStaticText" name="ID_STFRAME">
			<label>---</label>
			<pos>290,295</pos>
		</object>
		<object class="wxStaticText" name="ID_STTEXT_MISSING_LABEL">
			<label>Time Missing : </label>
			<pos>32,325</pos>
		</object>	
		<object class="wxStaticText" name="ID_STTIMEMISSING">
			<label>---</label>
			<pos>130,325</pos>
		</object>		
		<object class="wxGauge" name="ID_GAUGEPRG">
			<pos>24,360</pos>
			<size>344,28</size>
		</object>
		<object class="wxButton" name="ID_BUTTON1">
			<label>Cancel</label>
			<pos>152,400</pos>
		</object>
	</object>
</resource>
