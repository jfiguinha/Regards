//
//To Optimize : https://zz85.github.io/glsl-optimizer/
//
#version 330 core // Passage au mode moderne Core

uniform sampler2D sourceTex;
uniform sampler2D targetTex;

uniform float time;  // 0.0 -> 100.0
uniform float invertTex;

const float PI = 3.14159265358979323846;
const float MIN_AMOUNT = -0.16;
const float MAX_AMOUNT = 1.30;
const float SCALE = 512.0;
const float SHARPNESS = 3.0;
const float CYLINDER_RADIUS = 1.0 / (PI * 2.0);

float amount = (time / 100.0) * (MAX_AMOUNT - MIN_AMOUNT) + MIN_AMOUNT;
float cylinderCenter = amount;
float cylinderAngle = 2.0 * PI * amount;

in vec2 TexCoord; // Reu du Vertex Shader gnrique
out vec4 FragColor;

vec2 TextureCoordonnee() {
  vec2 coord = TexCoord.xy;
  if (invertTex == 1.0) coord.y = 1.0 - coord.y;
  return coord;
}

vec2 TextureTargetCoordonnee() { return TexCoord.xy; }

vec3 hitPoint(float hitAngle, float yc, vec3 point, mat3 rrotation) {
  point.y = hitAngle / (2.0 * PI);
  return rrotation * point;
}

vec4 antiAlias(vec4 color1, vec4 color2, float distance) {
  distance *= SCALE;
  if (distance < 0.0) return color2;
  if (distance > 2.0) return color1;
  float dd = pow(1.0 - distance / 2.0, SHARPNESS);
  return color1 + (color2 - color1) * dd;
}

float distanceToEdge(vec3 point) {
  float dx = abs(point.x > 0.5 ? 1.0 - point.x : point.x);
  float dy = abs(point.y > 0.5 ? 1.0 - point.y : point.y);

  if (point.x < 0.0) dx = -point.x;
  if (point.x > 1.0) dx = point.x - 1.0;
  if (point.y < 0.0) dy = -point.y;
  if (point.y > 1.0) dy = point.y - 1.0;

  if ((point.x < 0.0 || point.x > 1.0) && (point.y < 0.0 || point.y > 1.0)) {
    return sqrt(dx * dx + dy * dy);
  }
  return min(dx, dy);
}

vec4 seeThrough(float yc, vec2 p, mat3 rotation, mat3 rrotation) {
  float hitAngle = PI - (acos(yc / CYLINDER_RADIUS) - cylinderAngle);
  vec3 point = hitPoint(hitAngle, yc, rotation * vec3(p, 1.0), rrotation);

  if (yc <= 0.0 && (point.x < 0.0 || point.y < 0.0 || point.x > 1.0 || point.y > 1.0)) {
    return texture(targetTex, TextureTargetCoordonnee());
  }

  if (yc > 0.0) {
    return texture(sourceTex, p);
  }

  vec4 color = texture(sourceTex, point.xy);
  return antiAlias(color, vec4(0.0), distanceToEdge(point));
}

vec4 seeThroughWithShadow(float yc, vec2 p, vec3 point, mat3 rotation, mat3 rrotation) {
  float shadow = distanceToEdge(point) * 30.0;
  shadow = (1.0 - shadow) / 3.0;

  if (shadow < 0.0) {
    shadow = 0.0;
  } else {
    shadow *= amount;
  }

  vec4 color = seeThrough(yc, p, rotation, rrotation);
  color.rgb -= vec3(shadow);
  return color;
}

vec4 backside(float yc, vec3 point) {
  vec4 color = texture(sourceTex, point.xy);
  float gray = (color.r + color.g + color.b) / 15.0;
  gray += 0.8 * (pow(1.0 - abs(yc / CYLINDER_RADIUS), 0.2) / 2.0 + 0.5);
  color.rgb = vec3(gray);
  return color;
}

vec4 behindSurface(float yc, vec3 point, mat3 rrotation) {
  float shadow = (1.0 - ((-CYLINDER_RADIUS - yc) / amount * 7.0)) / 6.0;
  shadow *= 1.0 - abs(point.x - 0.5);
  yc = -CYLINDER_RADIUS - CYLINDER_RADIUS - yc;

  float hitAngle = (acos(yc / CYLINDER_RADIUS) + cylinderAngle) - PI;
  point = hitPoint(hitAngle, yc, point, rrotation);

  if (yc < 0.0 && point.x >= 0.0 && point.y >= 0.0 && point.x <= 1.0 &&
      point.y <= 1.0 && (hitAngle < PI || amount > 0.5)) {
    shadow = 1.0 - (sqrt((point.x - 0.5) * (point.x - 0.5) + (point.y - 0.5) * (point.y - 0.5)) / 0.71);
    shadow *= pow(-yc / CYLINDER_RADIUS, 3.0);
    shadow *= 0.5;
  } else {
    shadow = 0.0;
  }

  return vec4(texture(targetTex, TextureTargetCoordonnee()).rgb - shadow, 1.0);
}

void main(void) {
  const float angle = 30.0 * PI / 180.0;

  float c = cos(-angle);
  float s = sin(-angle);
  mat3 rotation = mat3(c, s, 0.0, -s, c, 0.0, 0.12, 0.258, 1.0);

  c = cos(angle);
  s = sin(angle);
  mat3 rrotation = mat3(c, s, 0.0, -s, c, 0.0, 0.15, -0.5, 1.0);

  vec2 targetCoord = TextureTargetCoordonnee();
  vec3 point = rotation * vec3(targetCoord, 1.0);
  float yc = point.y - cylinderCenter;

  if (yc < -CYLINDER_RADIUS) {
    FragColor = behindSurface(yc, point, rrotation);
    return;
  }

  if (yc > CYLINDER_RADIUS) {
    FragColor = texture(sourceTex, TextureCoordonnee());
    return;
  }

  float hitAngle = (acos(yc / CYLINDER_RADIUS) + cylinderAngle) - PI;
  float hitAngleMod = mod(hitAngle, 2.0 * PI);

  if ((hitAngleMod > PI && amount < 0.5) || (hitAngleMod > PI / 2.0 && amount < 0.0)) {
    FragColor = seeThrough(yc, TextureCoordonnee(), rotation, rrotation);
    return;
  }

  point = hitPoint(hitAngle, yc, point, rrotation);

  if (point.x < 0.0 || point.y < 0.0 || point.x > 1.0 || point.y > 1.0) {
    FragColor = seeThroughWithShadow(yc, TextureCoordonnee(), point, rotation, rrotation);
    return;
  }

  vec4 color = backside(yc, point);
  vec4 otherColor;

  if (yc < 0.0) {
    float shadow = 1.0 - (sqrt((point.x - 0.5) * (point.x - 0.5) + (point.y - 0.5) * (point.y - 0.5)) / 0.71);
    shadow *= pow(-yc / CYLINDER_RADIUS, 3.0);
    shadow *= 0.5;
    otherColor = vec4(0.0, 0.0, 0.0, shadow);
  } else {
    otherColor = texture(sourceTex, TextureCoordonnee());
  }

  color = antiAlias(color, otherColor, CYLINDER_RADIUS - abs(yc));
  vec4 throughColor = seeThroughWithShadow(yc, TextureCoordonnee(), point, rotation, rrotation);
  float edgeDistance = distanceToEdge(point);

  FragColor = antiAlias(color, throughColor, edgeDistance);
}