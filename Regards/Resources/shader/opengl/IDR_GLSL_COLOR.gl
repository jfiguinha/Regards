//
//To Optimize : https://zz85.github.io/glsl-optimizer/
//


#version 330 core

in vec2 TexCoord;

uniform sampler2D text;
uniform vec3 textColor;

out vec4 FragColor;

void main(void) {
    vec4 sampled = vec4(1.0, 1.0, 1.0, texture(text, TexCoord).r);
	FragColor = vec4(textColor, 1.0) * sampled;
}
