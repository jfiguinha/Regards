//
//To Optimize : https://zz85.github.io/glsl-optimizer/
//
#version 330 core

in vec2 TexCoord;
out vec4 FragColor;

uniform sampler2D texUnit;
uniform float fWidth;
uniform float fHeight;
uniform float top;
uniform float left;
uniform float right;
uniform float bottom;
uniform int sepia;
uniform int effectenable;
uniform int vhsEffect;
uniform float iTime;
uniform int grayscale;
uniform int sharpenMasking;
uniform int tone;
uniform int colorboost;
uniform int denoise;
uniform int filmgrain;
uniform float sharpness;
uniform float contrast;
uniform float brightness;
uniform float red;
uniform float green;
uniform float blue;

uniform float sigma;
uniform float threshold;
uniform float kSigma;
uniform float timer;

const float permTexUnit = 1.0/256.0;
const float permTexUnitHalf = 0.5/256.0;
const float grainamount = 0.03;
const float INV_SQRT_OF_2PI = 0.3989422804;
const float INV_PI = 0.3183098862;

vec4 rnm(in vec2 tc) 
{
    float noise = sin(dot(tc + vec2(timer,timer), vec2(12.9898,78.233))) * 43758.5453;
    return vec4(fract(noise)*2.0-1.0, fract(noise*1.2154)*2.0-1.0, fract(noise*1.3453)*2.0-1.0, fract(noise*1.3647)*2.0-1.0);
}

float fade(in float t) {
	return t*t*t*(t*(t*6.0-15.0)+10.0);
}

float pnoise3D(in vec3 p)
{
	vec3 pi = permTexUnit*floor(p)+permTexUnitHalf;
	vec3 pf = fract(p);

	float perm00 = rnm(pi.xy).a;
	vec3  grad000 = rnm(vec2(perm00, pi.z)).rgb * 4.0 - 1.0;
	float n000 = dot(grad000, pf);
	vec3  grad001 = rnm(vec2(perm00, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n001 = dot(grad001, pf - vec3(0.0, 0.0, 1.0));

	float perm01 = rnm(pi.xy + vec2(0.0, permTexUnit)).a;
	vec3  grad010 = rnm(vec2(perm01, pi.z)).rgb * 4.0 - 1.0;
	float n010 = dot(grad010, pf - vec3(0.0, 1.0, 0.0));
	vec3  grad011 = rnm(vec2(perm01, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n011 = dot(grad011, pf - vec3(0.0, 1.0, 1.0));

	float perm10 = rnm(pi.xy + vec2(permTexUnit, 0.0)).a;
	vec3  grad100 = rnm(vec2(perm10, pi.z)).rgb * 4.0 - 1.0;
	float n100 = dot(grad100, pf - vec3(1.0, 0.0, 0.0));
	vec3  grad101 = rnm(vec2(perm10, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n101 = dot(grad101, pf - vec3(1.0, 0.0, 1.0));

	float perm11 = rnm(pi.xy + vec2(permTexUnit, permTexUnit)).a;
	vec3  grad110 = rnm(vec2(perm11, pi.z)).rgb * 4.0 - 1.0;
	float n110 = dot(grad110, pf - vec3(1.0, 1.0, 0.0));
	vec3  grad111 = rnm(vec2(perm11, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n111 = dot(grad111, pf - vec3(1.0, 1.0, 1.0));

	vec4 n_x = mix(vec4(n000, n001, n010, n011), vec4(n100, n101, n110, n111), fade(pf.x));
	vec2 n_xy = mix(n_x.xy, n_x.zw, fade(pf.y));
	return mix(n_xy.x, n_xy.y, fade(pf.z));
}

vec4 TextureValue(float posX, float posY, float xDiff, float yDiff)
{
	vec2 resolution = vec2(1.0 / fWidth, 1.0 / fHeight); 
	return texture(texUnit, vec2(posX,posY) + resolution * vec2(xDiff, yDiff));
}

vec4 ContrastFilter(vec4 color, float contrast, float offset)
{
	float csupp = contrast * (offset - 256.0) + 128.0;
	vec3 rgb = clamp(contrast * (color.rgb * 255.0) + csupp, 0.0, 255.0);
	return vec4(rgb / 255.0, color.a);
}

vec4 LightnessFilter(vec4 color)
{
	float nChange = (2.55 * brightness) / 255.0;
	return vec4(color.rgb + nChange, color.a);
}

float rand(vec2 co) {
    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
}

float verticalBar(float pos, float uvY, float offset) {
    return (smoothstep(pos - 0.05, pos, uvY) - smoothstep(pos, pos + 0.05, uvY)) * offset;
}

vec4 vhsImage(vec4 color)
{
    vec2 uv = TexCoord;
    for (float i = 0.0; i < 0.71; i += 0.1313) {
        float d = mod(iTime * i, 1.7);
        float o = sin(1.0 - tan(iTime * 0.24 * i)) * 0.02;
        uv.x += verticalBar(d, uv.y, o);
    }
    
    float uvY = float(int(uv.y * 250.0)) / 250.0;
    uv.x += rand(vec2(iTime * 0.00001, uvY)) * 0.0088;

    vec2 offsetR = vec2(0.006 * sin(iTime), 0.0) * 1.3;
    vec2 offsetG = vec2(0.0073 * (cos(iTime * 0.97)), 0.0) * 1.3;
    
    return vec4(texture(texUnit, uv + offsetR).r, texture(texUnit, uv + offsetG).g, texture(texUnit, uv).b, 1.0);
}

vec4 ApplyFilter(vec4 src_color)
{	
	if(sharpenMasking == 1)
	{
		float posX = TexCoord.x;
		float posY = TexCoord.y;
		vec4 sum =  TextureValue(posX, posY, -1.0, -1.0) + TextureValue(posX, posY, 0.0, -1.0) + TextureValue(posX, posY, 1.0, -1.0) +
		            TextureValue(posX, posY, -1.0, 0.0)  + src_color                           + TextureValue(posX, posY, 1.0, 0.0) +
		            TextureValue(posX, posY, -1.0, 1.0)  + TextureValue(posX, posY, 0.0, 1.0)  + TextureValue(posX, posY, 1.0, 1.0);
		src_color = src_color + (src_color - (sum / 9.0)) * sharpness;		
	}

	if(tone == 1)
	{
		float offset = (contrast >= 0.0) ? (1.0 + (contrast / 100.0)) : (1.0 - (-contrast / 100.0));
		src_color = ContrastFilter(src_color, offset, 128.0);
		src_color = LightnessFilter(src_color);
	}

	if(colorboost == 1)
	{
		src_color.rgb = clamp(src_color.rgb + (vec3(red, green, blue) / 255.0), 0.0, 1.0);
	}

	if(grayscale == 1)
	{
		float gray = dot(src_color.rgb, vec3(0.299, 0.587, 0.114));
		src_color = vec4(vec3(gray), src_color.a);
	}
	
	if(sepia == 1)
	{
		// CORRECTION DU BUG SPIA via produit matriciel pur (conforme mathmatiquement)
		mat3 sepiaMat = mat3(
			0.393, 0.349, 0.272,
			0.769, 0.686, 0.534,
			0.189, 0.168, 0.131
		);
		src_color.rgb = sepiaMat * src_color.rgb;
	}
	
	return src_color;
}

// Version optimise de Denoise : lit directement la texture brute
vec4 Denoise(vec4 centrPx)
{
    float radius = floor(kSigma*sigma);
    float radQ = radius * radius;

    float invSigmaQx2 = .5 / (sigma * sigma);
    float invSigmaQx2PI = INV_PI * invSigmaQx2;
    float invThresholdSqx2 = .5 / (threshold * threshold);
    float invThresholdSqrt2PI = INV_SQRT_OF_2PI / threshold;

    float zBuff = 0.0;
    vec4 aBuff = vec4(0.0);
	float posX = TexCoord.x;
	float posY = TexCoord.y;	

    for (float x = -radius; x <= radius; x++) {
        float pt = sqrt(radQ - x * x);
        for (float y = -pt; y <= pt; y++) {
            float blurFactor = exp(-(x*x + y*y) * invSigmaQx2) * invSigmaQx2PI;
            
            // OPTIMISATION : On lit la texture brute, on n'appelle PAS ApplyFilter en boucle locale !
            vec4 walkPx = TextureValue(posX, posY, x, y); 
            vec4 dC = walkPx - centrPx;
            float deltaFactor = exp(-dot(dC, dC) * invThresholdSqx2) * invThresholdSqrt2PI * blurFactor;

            zBuff += deltaFactor;
            aBuff += deltaFactor * walkPx;
        }
    }
    return aBuff / max(zBuff, 0.000001);
}

void main(void)
{		
	float x = TexCoord.x;
	float y = TexCoord.y;
	vec4 src_color = texture(texUnit, TexCoord).rgba;
		
	if(x > left && x < right && y > top && y < bottom)													
	{
		if(effectenable == 0)
		{
			FragColor = src_color;
			return;
		}
		
        if(vhsEffect == 1)
        {
            src_color = vhsImage(src_color);
        }		
		
		// 1. On applique le Dbruitage d'abord (si activ) sur la texture source
		if(denoise == 1)
		{
			src_color = Denoise(src_color);
		}

		// 2. On applique les filtres d'effets (Nettet, Contraste, Spia) UNE SEULE FOIS
		src_color = ApplyFilter(src_color);

		// 3. Ajout du Grain de film  la fin
		if(filmgrain == 1)
		{
			vec4 noise = vec4(pnoise3D(vec3(TexCoord * vec2(fWidth, fHeight), 0.0)));
			if(grayscale == 0 && sepia == 0)
			{
				noise.g = pnoise3D(vec3(TexCoord * vec2(fWidth, fHeight), 1.0));
				noise.b = pnoise3D(vec3(TexCoord * vec2(fWidth, fHeight), 2.0));
			}
			src_color.rgb = src_color.rgb + noise.rgb * grainamount;
		}
	}
	FragColor = src_color;
}