//
//To Optimize : https://zz85.github.io/glsl-optimizer/
//
#version 330 core

uniform sampler2D sourceTex; // Image de dpart (photo 1)
uniform sampler2D targetTex; // Image d'arrive (photo 2)

uniform float time;          // Reoit l'tape de 0.0  100.0
uniform float invertTex;     // Inversion ventuelle

in vec2 TexCoord;
out vec4 FragColor;

// Configuration de l'effet
const float MAX_ZOOM = 8.0;      // Puissance maximale du zoom au centre de la transition
const int BLUR_SAMPLES = 10;     // Qualit du flou de mouvement radial

vec2 GetCorrectedCoord() {
    vec2 coord = TexCoord.xy;
    if (invertTex == 1.0) coord.y = 1.0 - coord.y;
    return coord;
}

void main(void) {
    vec2 uv = GetCorrectedCoord();
    vec2 center = vec2(0.5, 0.5); // Centre du zoom
    
    // Normalisation du temps entre 0.0 et 1.0
    float progress = time / 100.0;
    
    // Animation de la progression (courbe d'acclration douce)
    float animationProgress = smoothstep(0.0, 1.0, progress);
    
    vec4 color = vec4(0.0);
    float totalWeight = 0.0;
    
    // Dtermination de l'chelle (Zoom) et de l'intensit du flou selon la phase
    float scale;
    float blurIntensity;
    bool isFirstHalf = animationProgress < 0.5;
    
    if (isFirstHalf) {
        // Phase 1 : Zoom In sur l'image source (progress: 0.0 -> 0.5)
        float localProgress = animationProgress * 2.0; // Recadrage 0.0 -> 1.0
        scale = 1.0 + (MAX_ZOOM - 1.0) * localProgress * localProgress;
        blurIntensity = localProgress * 0.15;
    } else {
        // Phase 2 : Zoom Out depuis l'image cible (progress: 0.5 -> 1.0)
        float localProgress = (animationProgress - 0.5) * 2.0; // Recadrage 0.0 -> 1.0
        scale = MAX_ZOOM - (MAX_ZOOM - 1.0) * sqrt(localProgress);
        blurIntensity = (1.0 - localProgress) * 0.15;
    }
    
    // Application de la transformation de zoom (homothtie par rapport au centre)
    vec2 zoomedUV = (uv - center) / scale + center;
    
    // Gnration d'un flou radial (Motion Blur) centr pour accentuer l'effet de vitesse
    for (int i = 0; i < BLUR_SAMPLES; i++) {
        float factor = float(i) / float(BLUR_SAMPLES - 1);
        // Distribution des chantillons le plus long du vecteur allant du centre vers le pixel
        vec2 sampleUV = zoomedUV + (center - zoomedUV) * factor * blurIntensity;
        
        // Assurer que les coordonnes de texture ne bouclent pas de manire aberrante
        sampleUV = clamp(sampleUV, 0.0, 1.0);
        
        // chantillonnage de la bonne texture selon la phase de transition
        vec4 sampleColor = isFirstHalf ? texture(sourceTex, sampleUV) : texture(targetTex, sampleUV);
        
        // Pondration (les bords du flou s'estompent lgrement)
        float weight = 1.0 - (factor * 0.3);
        color += sampleColor * weight;
        totalWeight += weight;
    }
    
    color /= totalWeight;
    
    // Fondu enchan (Cross-fade) linaire au milieu pour lisser la transition de texture
    if (animationProgress > 0.4 && animationProgress < 0.6) {
        float mixFactor = (animationProgress - 0.4) / 0.2;
        vec4 colorSource = texture(sourceTex, clamp((uv - center) / (1.0 + (MAX_ZOOM - 1.0)) + center, 0.0, 1.0));
        vec4 colorTarget = texture(targetTex, clamp((uv - center) / MAX_ZOOM + center, 0.0, 1.0));
        color = mix(color, mix(colorSource, colorTarget, mixFactor), 0.3);
    }
    
    FragColor = color;
}