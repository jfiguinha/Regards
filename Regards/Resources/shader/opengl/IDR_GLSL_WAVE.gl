//
//To Optimize : https://zz85.github.io/glsl-optimizer/
//
#version 330 core


uniform sampler2D sourceTex; // Image de dpart (photo 1)
uniform sampler2D targetTex; // Image d'arrive (photo 2)

uniform float time;          // tape de 0.0  100.0
uniform float invertTex;     // Inversion ventuelle de la texture

in vec2 TexCoord;
out vec4 FragColor;

// Configuration de l'effet de vagues
const float FREQUENCY = 40.0;  // Nombre de vagues visibles
const float AMPLITUDE = 0.04;  // Force maximale de la distorsion
const float SPEED = 20.0;      // Vitesse de propagation de l'onde

vec2 GetCorrectedCoord() {
    vec2 coord = TexCoord.xy;
    if (invertTex == 1.0) coord.y = 1.0 - coord.y;
    return coord;
}

void main(void) {
    vec2 uv = GetCorrectedCoord();
    vec2 center = vec2(0.5, 0.5);
    
    // Normalisation du temps entre 0.0 et 1.0
    float progress = time / 100.0;
    
    // Calcul de la distance par rapport au centre du calque
    vec2 dir = uv - center;
    float dist = length(dir);
    
    // Cloche d'intensit : l'effet est maximal  progress = 0.5 et nul  0.0 et 1.0
    float waveIntensity = sin(progress * 3.14159265);
    
    // Calcul de la dformation sinusodale base sur la distance et le temps
    // L'utilisation de 'dir / dist' permet de repousser/attirer les pixels radialement
    vec2 distortedUV = uv;
    if (dist > 0.0) {
        float wave = sin(dist * FREQUENCY - progress * SPEED);
        distortedUV += (dir / dist) * wave * AMPLITUDE * waveIntensity;
    }
    
    // Assurer que les coordonnes restent dans les limites de la texture [0.0, 1.0]
    distortedUV = clamp(distortedUV, 0.0, 1.0);
    
    // chantillonnage des deux images avec les coordonnes dformes
    vec4 colorSource = texture(sourceTex, distortedUV);
    vec4 colorTarget = texture(targetTex, distortedUV);
    
    // Fondu enchan progressif (Cross-fade) synchronis avec la puissance des vagues
    FragColor = mix(colorSource, colorTarget, progress);
}