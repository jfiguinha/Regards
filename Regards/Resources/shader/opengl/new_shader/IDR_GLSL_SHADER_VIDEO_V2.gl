//
// Optimized Video Shader V2
//
// Fonctionnalités :
//   - VHS
//   - Sharpen Masking
//   - Contrast
//   - Brightness
//   - Color Boost
//   - Grayscale
//   - Sepia
//   - Denoise
//   - Film Grain
//   - Zone de traitement
//
// Optimisation principale V2 :
//   Le Denoise ne rappelle plus ApplyFilter() pour chaque
//   échantillon du kernel.
//
// ============================================================


// ============================================================
// UNIFORMS
// ============================================================

uniform sampler2D texUnit;

uniform float fWidth;
uniform float fHeight;

uniform float top;
uniform float left;
uniform float right;
uniform float bottom;

uniform int sepia;
uniform int effectenable;
uniform int vhsEffect;

uniform float iTime;

uniform int grayscale;
uniform int sharpenMasking;
uniform int tone;
uniform int colorboost;
uniform int denoise;
uniform int filmgrain;

uniform float sharpness;
uniform float contrast;
uniform float brightness;

uniform float red;
uniform float green;
uniform float blue;

uniform float sigma;
uniform float threshold;
uniform float kSigma;

uniform float timer;


// ============================================================
// CONSTANTS
// ============================================================

const float INV_PI       = 0.3183098861837907;
const float INV_SQRT_2PI = 0.3989422804014327;

const float GRAIN_AMOUNT = 0.03;

const float PERM_TEXEL_SIZE = 1.0 / 256.0;
const float PERM_TEXEL_HALF = 0.5 / 256.0;


// ============================================================
// TEXTURE
// ============================================================

vec2 TexelSize()
{
    return vec2(
        1.0 / fWidth,
        1.0 / fHeight
    );
}


vec4 TextureValue(
    vec2 uv,
    vec2 offset)
{
    return texture2D(
        texUnit,
        uv + TexelSize() * offset
    );
}


vec4 TextureValue(
    vec2 uv,
    float x,
    float y)
{
    return texture2D(
        texUnit,
        uv + TexelSize() * vec2(x, y)
    );
}


// ============================================================
// RANDOM
// ============================================================

float Rand(vec2 p)
{
    return fract(
        sin(
            dot(
                p,
                vec2(12.9898, 78.233)
            )
        ) * 43758.5453
    );
}


// ============================================================
// NOISE RANDOM
// ============================================================

vec4 Rnm(vec2 tc)
{
    float seed =
        sin(
            dot(
                tc + vec2(timer),
                vec2(12.9898, 78.233)
            )
        ) *
        43758.5453;

    return vec4(
        fract(seed)         * 2.0 - 1.0,
        fract(seed * 1.2154) * 2.0 - 1.0,
        fract(seed * 1.3453) * 2.0 - 1.0,
        fract(seed * 1.3647) * 2.0 - 1.0
    );
}


// ============================================================
// PERLIN NOISE
// ============================================================

float Fade(float t)
{
    return t * t * t *
           (t * (t * 6.0 - 15.0) + 10.0);
}


float PNoise3D(vec3 p)
{
    vec3 pi =
        floor(p) *
        PERM_TEXEL_SIZE +
        PERM_TEXEL_HALF;

    vec3 pf =
        fract(p);


    float perm00 =
        Rnm(pi.xy).a;

    float perm01 =
        Rnm(
            pi.xy +
            vec2(0.0, PERM_TEXEL_SIZE)
        ).a;

    float perm10 =
        Rnm(
            pi.xy +
            vec2(PERM_TEXEL_SIZE, 0.0)
        ).a;

    float perm11 =
        Rnm(
            pi.xy +
            vec2(
                PERM_TEXEL_SIZE,
                PERM_TEXEL_SIZE
            )
        ).a;


    vec3 grad000 =
        Rnm(
            vec2(perm00, pi.z)
        ).rgb * 4.0 - 1.0;

    vec3 grad001 =
        Rnm(
            vec2(
                perm00,
                pi.z + PERM_TEXEL_SIZE
            )
        ).rgb * 4.0 - 1.0;


    vec3 grad010 =
        Rnm(
            vec2(perm01, pi.z)
        ).rgb * 4.0 - 1.0;

    vec3 grad011 =
        Rnm(
            vec2(
                perm01,
                pi.z + PERM_TEXEL_SIZE
            )
        ).rgb * 4.0 - 1.0;


    vec3 grad100 =
        Rnm(
            vec2(perm10, pi.z)
        ).rgb * 4.0 - 1.0;

    vec3 grad101 =
        Rnm(
            vec2(
                perm10,
                pi.z + PERM_TEXEL_SIZE
            )
        ).rgb * 4.0 - 1.0;


    vec3 grad110 =
        Rnm(
            vec2(perm11, pi.z)
        ).rgb * 4.0 - 1.0;

    vec3 grad111 =
        Rnm(
            vec2(
                perm11,
                pi.z + PERM_TEXEL_SIZE
            )
        ).rgb * 4.0 - 1.0;


    float n000 =
        dot(grad000, pf);

    float n001 =
        dot(
            grad001,
            pf - vec3(0.0, 0.0, 1.0)
        );

    float n010 =
        dot(
            grad010,
            pf - vec3(0.0, 1.0, 0.0)
        );

    float n011 =
        dot(
            grad011,
            pf - vec3(0.0, 1.0, 1.0)
        );

    float n100 =
        dot(
            grad100,
            pf - vec3(1.0, 0.0, 0.0)
        );

    float n101 =
        dot(
            grad101,
            pf - vec3(1.0, 0.0, 1.0)
        );

    float n110 =
        dot(
            grad110,
            pf - vec3(1.0, 1.0, 0.0)
        );

    float n111 =
        dot(
            grad111,
            pf - vec3(1.0, 1.0, 1.0)
        );


    float fx = Fade(pf.x);
    float fy = Fade(pf.y);
    float fz = Fade(pf.z);


    vec4 nx =
        mix(
            vec4(
                n000,
                n001,
                n010,
                n011
            ),
            vec4(
                n100,
                n101,
                n110,
                n111
            ),
            fx
        );


    vec2 nxy =
        mix(
            nx.xy,
            nx.zw,
            fy
        );


    return mix(
        nxy.x,
        nxy.y,
        fz
    );
}


// ============================================================
// VHS
// ============================================================

const float VHS_RANGE = 0.05;
const float VHS_NOISE_QUALITY = 250.0;
const float VHS_NOISE_INTENSITY = 0.0088;
const float VHS_OFFSET_INTENSITY = 0.02;
const float VHS_COLOR_OFFSET = 1.3;


float VerticalBar(
    float pos,
    float uvY,
    float offset)
{
    float edge0 =
        pos - VHS_RANGE;

    float edge1 =
        pos + VHS_RANGE;

    return
        smoothstep(
            edge0,
            pos,
            uvY
        ) * offset
        -
        smoothstep(
            pos,
            edge1,
            uvY
        ) * offset;
}


vec4 VHSImage(vec2 uv)
{
    for (
        float i = 0.0;
        i < 0.71;
        i += 0.1313
    )
    {
        float d =
            mod(
                iTime * i,
                1.7
            );

        float o =
            sin(
                1.0 -
                tan(
                    iTime *
                    0.24 *
                    i
                )
            );

        o *= VHS_OFFSET_INTENSITY;

        uv.x +=
            VerticalBar(
                d,
                uv.y,
                o
            );
    }


    float uvY =
        floor(
            uv.y *
            VHS_NOISE_QUALITY
        ) /
        VHS_NOISE_QUALITY;


    float noise =
        Rand(
            vec2(
                iTime * 0.00001,
                uvY
            )
        );


    uv.x +=
        noise *
        VHS_NOISE_INTENSITY;


    vec2 offsetR =
        vec2(
            0.006 * sin(iTime),
            0.0
        ) *
        VHS_COLOR_OFFSET;


    vec2 offsetG =
        vec2(
            0.0073 * cos(iTime * 0.97),
            0.0
        ) *
        VHS_COLOR_OFFSET;


    float r =
        texture2D(
            texUnit,
            uv + offsetR
        ).r;


    float g =
        texture2D(
            texUnit,
            uv + offsetG
        ).g;


    float b =
        texture2D(
            texUnit,
            uv
        ).b;


    return vec4(
        r,
        g,
        b,
        1.0
    );
}


// ============================================================
// SHARPEN
// ============================================================

vec4 SharpenMasking(
    vec4 center,
    vec2 uv)
{
    vec4 sum = vec4(0.0);

    sum += TextureValue(uv, -1.0, -1.0);
    sum += TextureValue(uv,  0.0, -1.0);
    sum += TextureValue(uv,  1.0, -1.0);

    sum += TextureValue(uv, -1.0,  0.0);
    sum += center;
    sum += TextureValue(uv,  1.0,  0.0);

    sum += TextureValue(uv, -1.0,  1.0);
    sum += TextureValue(uv,  0.0,  1.0);
    sum += TextureValue(uv,  1.0,  1.0);


    vec4 blur =
        sum * (1.0 / 9.0);


    return center +
           (center - blur) *
           sharpness;
}


// ============================================================
// TONE
// ============================================================

vec4 ApplyTone(vec4 color)
{
    float localContrast;

    if (contrast >= 0.0)
    {
        localContrast =
            1.0 +
            contrast * 0.01;
    }
    else
    {
        localContrast =
            1.0 +
            contrast * 0.01;
    }


    float offsetValue =
        localContrast *
        (128.0 - 256.0) +
        128.0;


    color.rgb =
        clamp(
            color.rgb *
            localContrast +
            offsetValue / 255.0,
            0.0,
            1.0
        );


    float brightnessOffset =
        brightness *
        (2.55 / 255.0);


    color.rgb +=
        brightnessOffset;


    return color;
}


// ============================================================
// COLOR BOOST
// ============================================================

vec4 ApplyColorBoost(vec4 color)
{
    color.rgb =
        clamp(
            color.rgb +
            vec3(
                red,
                green,
                blue
            ) *
            (1.0 / 255.0),
            0.0,
            1.0
        );

    return color;
}


// ============================================================
// GRAYSCALE
// ============================================================

vec4 ApplyGrayscale(vec4 color)
{
    float luminance =
        dot(
            color.rgb,
            vec3(
                0.299,
                0.587,
                0.114
            )
        );


    return vec4(
        vec3(luminance),
        color.a
    );
}


// ============================================================
// SEPIA
// ============================================================

vec4 ApplySepia(vec4 color)
{
    float luminance =
        dot(
            color.rgb,
            vec3(
                0.299,
                0.587,
                0.114
            )
        );


    vec3 result =
        luminance *
        vec3(
            1.351,
            1.203,
            0.937
        );


    return vec4(
        clamp(
            result,
            0.0,
            1.0
        ),
        color.a
    );
}


// ============================================================
// FILTERS WITHOUT DENOISE
//
// Important : cette fonction ne doit pas être appelée
// à l'intérieur du Denoise.
//
// ============================================================

vec4 ApplyBasicFilters(
    vec4 color,
    vec2 uv)
{
    if (sharpenMasking == 1)
    {
        color =
            SharpenMasking(
                color,
                uv
            );
    }


    if (tone == 1)
    {
        color =
            ApplyTone(color);
    }


    if (colorboost == 1)
    {
        color =
            ApplyColorBoost(color);
    }


    if (grayscale == 1)
    {
        color =
            ApplyGrayscale(color);
    }


    if (sepia == 1)
    {
        color =
            ApplySepia(color);
    }


    return color;
}


// ============================================================
// DENOISE V2
//
// IMPORTANT :
// Le kernel travaille directement sur la texture source.
//
// Ancienne version :
//
// Denoise()
//     -> ApplyFilter()
//          -> Sharpen
//               -> 9 texture2D()
//
// Nouvelle version :
//
// Denoise()
//     -> texture2D()
//
// Cela réduit énormément le nombre d'accès texture.
//
// ============================================================

vec4 DenoiseV2(
    vec4 centerPixel,
    vec2 uv)
{
    float safeSigma =
        max(
            sigma,
            0.0001
        );


    float safeThreshold =
        max(
            threshold,
            0.0001
        );


    float radius =
        floor(
            kSigma *
            safeSigma
        );


    //
    // Limite de sécurité.
    //
    // Évite un kernel gigantesque si les paramètres
    // sont accidentellement trop élevés.
    //
    radius =
        min(
            radius,
            8.0
        );


    float radiusSquared =
        radius *
        radius;


    float invSigmaQx2 =
        0.5 /
        (safeSigma * safeSigma);


    float invSigmaQx2PI =
        INV_PI *
        invSigmaQx2;


    float invThresholdSqx2 =
        0.5 /
        (safeThreshold * safeThreshold);


    float invThresholdSqrt2PI =
        INV_SQRT_2PI /
        safeThreshold;


    float zBuffer = 0.0;

    vec4 accumulated =
        vec4(0.0);


    //
    // Pré-calcul.
    //
    vec2 texel =
        TexelSize();


    //
    // Circular Gaussian kernel.
    //
    for (
        float dx = -radius;
        dx <= radius;
        dx += 1.0
    )
    {
        float yRadius =
            sqrt(
                max(
                    radiusSquared -
                    dx * dx,
                    0.0
                )
            );


        for (
            float dy = -yRadius;
            dy <= yRadius;
            dy += 1.0
        )
        {
            vec2 delta =
                vec2(dx, dy);


            float distanceSquared =
                dot(
                    delta,
                    delta
                );


            //
            // Spatial Gaussian.
            //
            float blurFactor =
                exp(
                    -distanceSquared *
                    invSigmaQx2
                ) *
                invSigmaQx2PI;


            //
            // Lecture DIRECTE.
            //
            vec4 sampleColor =
                texture2D(
                    texUnit,
                    uv + delta * texel
                );


            //
            // Color distance.
            //
            vec4 colorDelta =
                sampleColor -
                centerPixel;


            float colorDistance =
                dot(
                    colorDelta,
                    colorDelta
                );


            float deltaFactor =
                exp(
                    -colorDistance *
                    invThresholdSqx2
                ) *
                invThresholdSqrt2PI *
                blurFactor;


            zBuffer +=
                deltaFactor;


            accumulated +=
                deltaFactor *
                sampleColor;
        }
    }


    if (zBuffer > 0.000001)
    {
        return accumulated /
               zBuffer;
    }


    return centerPixel;
}


// ============================================================
// FILM GRAIN
// ============================================================

vec4 ApplyFilmGrain(
    vec4 color,
    vec2 uv)
{
    vec2 pixelCoord =
        uv *
        vec2(
            fWidth,
            fHeight
        );


    float noiseR =
        PNoise3D(
            vec3(
                pixelCoord,
                0.0
            )
        );


    if (grayscale == 0)
    {
        float noiseG =
            PNoise3D(
                vec3(
                    pixelCoord,
                    1.0
                )
            );


        float noiseB =
            PNoise3D(
                vec3(
                    pixelCoord,
                    2.0
                )
            );


        color.rgb +=
            vec3(
                noiseR,
                noiseG,
                noiseB
            ) *
            GRAIN_AMOUNT;
    }
    else
    {
        color.rgb +=
            noiseR *
            GRAIN_AMOUNT;
    }


    return color;
}


// ============================================================
// MAIN
// ============================================================

void main(void)
{
    vec2 uv =
        gl_TexCoord[0].st;


    float x =
        uv.x;

    float y =
        uv.y;


    //
    // Source.
    //
    vec4 color =
        texture2D(
            texUnit,
            uv
        );


    // ========================================================
    // ZONE CHECK
    // ========================================================

    if (x <= left ||
        x >= right ||
        y <= top ||
        y >= bottom)
    {
        gl_FragColor =
            color;

        return;
    }


    // ========================================================
    // EFFECT DISABLED
    // ========================================================

    if (effectenable == 0)
    {
        gl_FragColor =
            color;

        return;
    }


    // ========================================================
    // VHS
    // ========================================================

    if (vhsEffect == 1)
    {
        color =
            VHSImage(uv);
    }


    // ========================================================
    // DENOISE
    //
    // On fait le Denoise AVANT les filtres classiques.
    //
    // C'est volontaire :
    // les filtres ne sont plus exécutés pour chaque sample.
    //
    // ========================================================

    if (denoise == 1)
    {
        color =
            DenoiseV2(
                color,
                uv
            );
    }


    // ========================================================
    // BASIC FILTERS
    // ========================================================

    color =
        ApplyBasicFilters(
            color,
            uv
        );


    // ========================================================
    // FILM GRAIN
    // ========================================================

    if (filmgrain == 1)
    {
        color =
            ApplyFilmGrain(
                color,
                uv
            );
    }


    // ========================================================
    // OUTPUT
    // ========================================================

    gl_FragColor =
        color;
}