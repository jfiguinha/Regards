// ============================================================================
// Optimized OpenGL interpolation shader
//
// Texture format:
//     RGBA
//
// interpolation:
//     0  = Nearest
//     1  = Bilinear
//     2  = Bicubic / Catmull-Rom
//     3  = Bicubic / Catmull-Rom
//     4  = Bicubic / Catmull-Rom
//     5  = Bicubic / Catmull-Rom
//     6  = Bicubic / Catmull-Rom
//     7  = Bicubic / Catmull-Rom
//
//     interpolation >= 8:
//         type = interpolation - 7
//
//         1  = BBox
//         2  = Hermite
//         3  = Hanning
//         4  = Catmull-Rom
//         5  = Mitchell
//         6  = Triangle
//         7  = Quadratic
//         8  = Blackman
//         9  = Hamming
//         10 = Gaussian
//         11 = Bilinear
//
// ============================================================================

uniform sampler2D ImageTexture;

uniform float widthTex;
uniform float heightTex;

uniform int widthIn;
uniform int heightIn;
uniform int widthOut;
uniform int heightOut;

uniform int flipH;
uniform int flipV;

uniform int angle;

uniform int left;
uniform int top;

uniform int interpolation;


// ============================================================================
// Constants
// ============================================================================

const float FILTER_PI  = 3.14159265358979323846;
const float FILTER_2PI = 6.28318530717958647692;
const float FILTER_4PI = 12.56637061435917295384;

const float FILTER_EPSILON = 0.000001;


// ============================================================================
// Texture coordinates
//
// The shader assumes GL_NEAREST for ImageTexture.
//
// Coordinates are clamped manually so interpolation never produces a black
// border when a 4x4 kernel reaches the image boundary.
// ============================================================================

vec2 ClampTexelCoordinate(
    vec2 texelCoord)
{
    float maxX = widthTex  - 1.0;
    float maxY = heightTex - 1.0;

    texelCoord.x = clamp(texelCoord.x, 0.0, maxX);
    texelCoord.y = clamp(texelCoord.y, 0.0, maxY);

    return texelCoord;
}


// ============================================================================
// Read one texel using integer pixel coordinates
// ============================================================================

vec4 TexturePixel(
    float x,
    float y)
{
    vec2 pixel = ClampTexelCoordinate(vec2(x, y));

    // Pixel center.
    vec2 uv =
        (pixel + vec2(0.5, 0.5)) /
        vec2(widthTex, heightTex);

    return texture2D(ImageTexture, uv);
}


// ============================================================================
// Read relative to the current interpolation position
//
// posX / posY are normalized texture coordinates.
//
// xDiff / yDiff are pixel offsets.
// ============================================================================

vec4 TextureValue(
    float posX,
    float posY,
    int xDiff,
    int yDiff)
{
    float pixelX =
        floor(posX * widthTex) +
        float(xDiff);

    float pixelY =
        floor(posY * heightTex) +
        float(yDiff);

    return TexturePixel(pixelX, pixelY);
}


// ============================================================================
// BBox filter
// ============================================================================

float BBoxFilter(
    float x)
{
    return abs(x) <= 0.5
        ? 1.0
        : 0.0;
}


// ============================================================================
// Hermite filter
// ============================================================================

float HermiteFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    return
        (2.0 * ax - 3.0) * ax * ax + 1.0;
}


// ============================================================================
// Hanning filter
// ============================================================================

float HanningFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    return
        0.54 +
        0.46 * cos(FILTER_PI * x);
}


// ============================================================================
// Catmull-Rom
//
// Standard Catmull-Rom cubic spline.
//
// Support:
//     [-2, 2]
// ============================================================================

float CatmullRomFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 2.0)
        return 0.0;

    if (ax < 1.0)
    {
        return
            1.5 * ax * ax * ax
          - 2.5 * ax * ax
          + 1.0;
    }

    return
        -0.5 * ax * ax * ax
        + 2.5 * ax * ax
        - 4.0 * ax
        + 2.0;
}


// ============================================================================
// Mitchell-Netravali
//
// B = 1/3
// C = 1/3
// ============================================================================

float MitchellFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 2.0)
        return 0.0;

    const float B = 0.3333333333333333;
    const float C = 0.3333333333333333;

    if (ax < 1.0)
    {
        return
            (
                (12.0 - 9.0 * B - 6.0 * C) * ax * ax * ax
              + (-18.0 + 12.0 * B + 6.0 * C) * ax * ax
              + (6.0 - 2.0 * B)
            ) / 6.0;
    }

    return
        (
            (-B - 6.0 * C) * ax * ax * ax
          + (6.0 * B + 30.0 * C) * ax * ax
          + (-12.0 * B - 48.0 * C) * ax
          + (8.0 * B + 24.0 * C)
        ) / 6.0;
}


// ============================================================================
// Triangle
// ============================================================================

float TriangleFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    return 1.0 - ax;
}


// ============================================================================
// Quadratic
// ============================================================================

float QuadraticFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.5)
        return 0.0;

    if (ax < 0.5)
        return 0.75 - ax * ax;

    float t = 1.5 - ax;

    return 0.5 * t * t;
}


// ============================================================================
// Blackman
// ============================================================================

float BlackmanFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    return
        0.42
      + 0.5 * cos(FILTER_2PI * x / 2.0)
      + 0.08 * cos(FILTER_4PI * x / 2.0);
}


// ============================================================================
// Hamming + sinc
// ============================================================================

float HammingFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    float window =
        0.54 +
        0.46 * cos(FILTER_2PI * x);

    float sinc;

    if (ax < FILTER_EPSILON)
    {
        sinc = 1.0;
    }
    else
    {
        float px = FILTER_PI * x;

        sinc = sin(px) / px;
    }

    return window * sinc;
}


// ============================================================================
// Gaussian
// ============================================================================

float GaussianFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.25)
        return 0.0;

    return
        exp(-0.5 * x * x)
        * 0.3989422804014327;
}


// ============================================================================
// Bilinear
// ============================================================================

float BilinearFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 1.0)
        return 0.0;

    return 1.0 - ax;
}


// ============================================================================
// Cubic
//
// Classic cubic B-spline.
// ============================================================================

float CubicFilter(
    float x)
{
    float ax = abs(x);

    if (ax >= 2.0)
        return 0.0;

    if (ax < 1.0)
    {
        return
            (
                4.0
              - 6.0 * ax * ax
              + 3.0 * ax * ax * ax
            ) / 6.0;
    }

    float t = 2.0 - ax;

    return
        t * t * t / 6.0;
}


// ============================================================================
// Filter selection
// ============================================================================

float KernelFilterSelection(
    float x,
    int type)
{
    switch (type)
    {
        case 1:
            return BBoxFilter(x);

        case 2:
            return HermiteFilter(x);

        case 3:
            return HanningFilter(x);

        case 4:
            return CatmullRomFilter(x);

        case 5:
            return MitchellFilter(x);

        case 6:
            return TriangleFilter(x);

        case 7:
            return QuadraticFilter(x);

        case 8:
            return BlackmanFilter(x);

        case 9:
            return HammingFilter(x);

        case 10:
            return GaussianFilter(x);

        case 11:
            return BilinearFilter(x);

        default:
            return CubicFilter(x);
    }
}


// ============================================================================
// Calculate normalized filter weights
//
// Four samples are always generated. This is necessary for the cubic filters.
// ============================================================================

vec4 ComputeWeights4(
    float fraction,
    int type)
{
    vec4 weights;

    weights.x =
        KernelFilterSelection(
            -1.0 - fraction,
            type);

    weights.y =
        KernelFilterSelection(
            -fraction,
            type);

    weights.z =
        KernelFilterSelection(
            1.0 - fraction,
            type);

    weights.w =
        KernelFilterSelection(
            2.0 - fraction,
            type);

    float sum =
        weights.x +
        weights.y +
        weights.z +
        weights.w;

    if (abs(sum) > FILTER_EPSILON)
    {
        weights /= sum;
    }
    else
    {
        weights =
            vec4(0.0, 1.0, 0.0, 0.0);
    }

    return weights;
}


// ============================================================================
// Optimized horizontal interpolation
// ============================================================================

vec4 FilterHorizontal(
    float posX,
    float posY,
    int type,
    vec4 weights)
{
    float pixelX =
        floor(posX * widthTex);

    float pixelY =
        floor(posY * heightTex);

    vec4 p0 =
        TexturePixel(
            pixelX - 1.0,
            pixelY);

    vec4 p1 =
        TexturePixel(
            pixelX,
            pixelY);

    vec4 p2 =
        TexturePixel(
            pixelX + 1.0,
            pixelY);

    vec4 p3 =
        TexturePixel(
            pixelX + 2.0,
            pixelY);

    return
        p0 * weights.x +
        p1 * weights.y +
        p2 * weights.z +
        p3 * weights.w;
}


// ============================================================================
// Main 4x4 separable interpolation
// ============================================================================

vec4 KernelExecution(
    float posX,
    float posY,
    int type)
{
    float pixelX =
        posX * widthTex;

    float pixelY =
        posY * heightTex;

    float baseX =
        floor(pixelX);

    float baseY =
        floor(pixelY);

    float fractionX =
        pixelX - baseX;

    float fractionY =
        pixelY - baseY;

    vec4 weightsX =
        ComputeWeights4(
            fractionX,
            type);

    vec4 weightsY =
        ComputeWeights4(
            fractionY,
            type);

    // ------------------------------------------------------------------------
    // Four horizontal passes
    // ------------------------------------------------------------------------

    float py0 =
        (baseY - 1.0) / heightTex;

    float py1 =
        baseY / heightTex;

    float py2 =
        (baseY + 1.0) / heightTex;

    float py3 =
        (baseY + 2.0) / heightTex;

    vec4 row0 =
        FilterHorizontal(
            posX,
            py0,
            type,
            weightsX);

    vec4 row1 =
        FilterHorizontal(
            posX,
            py1,
            type,
            weightsX);

    vec4 row2 =
        FilterHorizontal(
            posX,
            py2,
            type,
            weightsX);

    vec4 row3 =
        FilterHorizontal(
            posX,
            py3,
            type,
            weightsX);

    // ------------------------------------------------------------------------
    // Vertical pass
    // ------------------------------------------------------------------------

    return
        row0 * weightsY.x +
        row1 * weightsY.y +
        row2 * weightsY.z +
        row3 * weightsY.w;
}


// ============================================================================
// Bilinear interpolation
//
// Uses four explicit nearest texels.
// ============================================================================

vec4 BilinearInterpolation(
    vec2 texCoord)
{
    float pixelX =
        texCoord.x * widthTex;

    float pixelY =
        texCoord.y * heightTex;

    float baseX =
        floor(pixelX);

    float baseY =
        floor(pixelY);

    float fx =
        pixelX - baseX;

    float fy =
        pixelY - baseY;

    vec4 p00 =
        TexturePixel(
            baseX,
            baseY);

    vec4 p10 =
        TexturePixel(
            baseX + 1.0,
            baseY);

    vec4 p01 =
        TexturePixel(
            baseX,
            baseY + 1.0);

    vec4 p11 =
        TexturePixel(
            baseX + 1.0,
            baseY + 1.0);

    vec4 row0 =
        mix(p00, p10, fx);

    vec4 row1 =
        mix(p01, p11, fx);

    return mix(row0, row1, fy);
}


// ============================================================================
// Nearest
// ============================================================================

vec4 NearestInterpolation(
    vec2 texCoord)
{
    float pixelX =
        floor(texCoord.x * widthTex);

    float pixelY =
        floor(texCoord.y * heightTex);

    return TexturePixel(
        pixelX,
        pixelY);
}


// ============================================================================
// Calculate source position
//
// posX / posY are in output pixel coordinates.
//
// The transformation follows the same axis convention as the OpenCL version.
// ============================================================================

vec2 CalculateSourcePosition(
    float posX,
    float posY,
    float outputWidth,
    float outputHeight)
{
    float sourceX = posX;
    float sourceY = posY;

    // ------------------------------------------------------------------------
    // Rotation
    // ------------------------------------------------------------------------

    if (angle == 90)
    {
        float tmp = sourceX;

        sourceX =
            sourceY;

        sourceY =
            outputHeight - tmp - 1.0;
    }
    else if (angle == 180)
    {
        sourceX =
            outputWidth - sourceX - 1.0;

        sourceY =
            outputHeight - sourceY - 1.0;
    }
    else if (angle == 270)
    {
        float tmp = sourceX;

        sourceX =
            outputWidth - sourceY - 1.0;

        sourceY =
            tmp;
    }

    // ------------------------------------------------------------------------
    // Flip
    // ------------------------------------------------------------------------

    if (angle == 90 || angle == 270)
    {
        if (flipV == 1)
        {
            sourceX =
                outputHeight - sourceX - 1.0;
        }

        if (flipH == 1)
        {
            sourceY =
                outputWidth - sourceY - 1.0;
        }
    }
    else
    {
        if (flipH == 1)
        {
            sourceX =
                outputWidth - sourceX - 1.0;
        }

        if (flipV == 1)
        {
            sourceY =
                outputHeight - sourceY - 1.0;
        }
    }

    return vec2(sourceX, sourceY);
}


// ============================================================================
// Main
// ============================================================================

void main()
{
    // ------------------------------------------------------------------------
    // Output texture coordinate
    // ------------------------------------------------------------------------

    vec2 texCoord =
        gl_TexCoord[0].st;

    // ------------------------------------------------------------------------
    // Dimensions
    //
    // widthOut / heightOut describe the actual displayed output.
    // ------------------------------------------------------------------------

    float fWidthOut =
        float(widthOut);

    float fHeightOut =
        float(heightOut);

    // ------------------------------------------------------------------------
    // Input pixel coordinates corresponding to the current fragment.
    // ------------------------------------------------------------------------

    float xPixel =
        texCoord.x * float(widthIn);

    float yPixel =
        texCoord.y * float(heightIn);

    // ------------------------------------------------------------------------
    // Crop / zone calculation
    // ------------------------------------------------------------------------

    float leftLocal =
        0.5 * float(widthIn - widthOut);

    float topLocal =
        0.5 * float(heightIn - heightOut);

    leftLocal =
        max(leftLocal, 0.0);

    topLocal =
        max(topLocal, 0.0);

    // ------------------------------------------------------------------------
    // Outside of active zone
    // ------------------------------------------------------------------------

    if (xPixel < leftLocal ||
        yPixel < topLocal ||
        xPixel >= float(widthIn) - leftLocal ||
        yPixel >= float(heightIn) - topLocal)
    {
        gl_FragColor =
            vec4(0.0);

        return;
    }

    // ------------------------------------------------------------------------
    // Position in the output image
    // ------------------------------------------------------------------------

    float posX =
        (xPixel - leftLocal)
        + float(left);

    float posY =
        (yPixel - topLocal)
        + float(top);

    // ------------------------------------------------------------------------
    // Rotation / flipping
    // ------------------------------------------------------------------------

    vec2 transformed =
        CalculateSourcePosition(
            posX,
            posY,
            fWidthOut,
            fHeightOut);

    posX =
        transformed.x;

    posY =
        transformed.y;

    // ------------------------------------------------------------------------
    // Convert to normalized texture coordinates.
    //
    // For 90 / 270 the output axes are exchanged.
    // ------------------------------------------------------------------------

    float localX;
    float localY;

    if (angle == 90 ||
        angle == 270)
    {
        localX =
            posX / fHeightOut;

        localY =
            posY / fWidthOut;
    }
    else
    {
        localX =
            posX / fWidthOut;

        localY =
            posY / fHeightOut;
    }

    vec2 localTexCoord =
        vec2(localX, localY);

    // ------------------------------------------------------------------------
    // Interpolation selection
    // ------------------------------------------------------------------------

    vec4 data;

    if (interpolation == 0)
    {
        // ------------------------------------------------------------
        // Nearest
        // ------------------------------------------------------------

        data =
            NearestInterpolation(
                localTexCoord);
    }
    else if (interpolation == 1)
    {
        // ------------------------------------------------------------
        // Bilinear
        // ------------------------------------------------------------

        data =
            BilinearInterpolation(
                localTexCoord);
    }
    else
    {
        // ------------------------------------------------------------
        // Cubic / custom filters
        // ------------------------------------------------------------

        int filterType;

        if (interpolation >= 8)
        {
            filterType =
                interpolation - 7;
        }
        else
        {
            // interpolation 2..7
            // Use Catmull-Rom for the bicubic path.
            filterType = 4;
        }

        data =
            KernelExecution(
                localTexCoord.x,
                localTexCoord.y,
                filterType);
    }

    gl_FragColor =
        clamp(data, 0.0, 1.0);
}